# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key — required for oauth_tokens / confirmation_log (RLS-protected tables)
SUPABASE_SERVICE_KEY=

# Google OAuth (OAuth 2.0 Web Application client)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://church-scheduler.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional overrides
# GOOGLE_REDIRECT_URI=https://church-scheduler.vercel.app/api/auth/google/callback
# APP_URL=https://church-scheduler.vercel.app
# APP_TIMEZONE=America/Denver
